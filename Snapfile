# Snapfile
# The list of devices you want to take the screenshots from
devices([
  "iPad Pro 13-inch (M4)",
  "iPad Pro 11-inch (M4)",
])

# The list of languages you want to take screenshots in
languages([
  "en-US",
])

# The scheme name of your UI Test target
# NOTE: You must create a UI Test target named 'NotesAppUITests' in your Xcode project.
scheme "NotesApp"

# The project path
project "NotesApp.xcodeproj"

# The output directory for the screenshots
output_directory "fastlane/screenshots"
